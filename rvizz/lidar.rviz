Panels:
  - Class: rviz_common/Displays
    Name: Displays

Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Topic:
        Value: /scan
      Enabled: true
      Color Transformer: FlatColor
      Size (m): 0.1
      Style: Flat Squares
      Color: 255; 0; 0
      
  Global Options:
    Fixed Frame: Lidar